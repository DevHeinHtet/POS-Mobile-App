@using POSMobileApp.ViewModels.Categories
@model IEnumerable<POSMobileApp.ViewModels.Products.ProductSummaryVM>
@{
    ViewData["Title"] = "Menu";
    var activeCategory = TempData["ActiveCategory"]?.ToString() ?? "All";
    var cartCount = TempData["CartItemCount"] ?? 0;
    var cartTotal = TempData["CartTotal"] ?? 0.00m;

    var dbCategories = ViewBag.Categories as List<CategorySummaryVM> ?? new List<CategorySummaryVM>();
}

<div class="h-full flex flex-col lg:flex-row overflow-hidden">

    <!-- MAIN PRODUCT PANEL -->
    <div class="flex-1 flex flex-col overflow-y-auto px-4 py-4 lg:px-6 space-y-4 pb-28 lg:pb-6">

        <!-- Search Bar -->
        <div class="relative w-full max-w-xl">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-neutral-500">
                <span class="material-symbols-outlined text-xl">search</span>
            </span>
            <input type="text" placeholder="Search products..."
                   class="w-full bg-[#1c1c1e] text-neutral-200 placeholder-neutral-500 text-sm rounded-xl pl-10 pr-4 py-3 focus:outline-none border border-neutral-800 focus:border-amber-600/50 transition duration-200" />
        </div>

        <!-- Category Menu -->
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 shrink-0">
            @{
                var isAllActive = string.Equals(activeCategory, "All", StringComparison.OrdinalIgnoreCase);
            }
            <a href="@Url.Action("Index", "Product", new { category = "All" })"
               class="px-5 py-2 rounded-full text-xs font-semibold tracking-wider whitespace-nowrap transition-all duration-200 @(isAllActive ? "bg-amber-700/80 text-amber-100 border border-amber-600/30" : "bg-[#1c1c1e] text-neutral-400 hover:text-white hover:bg-[#252529]")">
                All
            </a>

            @foreach (var cat in dbCategories)
            {
                var isActive = string.Equals(activeCategory, cat.Name, StringComparison.OrdinalIgnoreCase);
                <a href="@Url.Action("Index", "Product", new { category = cat.Name })"
                   class="px-5 py-2 rounded-full text-xs font-semibold tracking-wider whitespace-nowrap transition-all duration-200 @(isActive ? "bg-amber-700/80 text-amber-100 border border-amber-600/30" : "bg-[#1c1c1e] text-neutral-400 hover:text-white hover:bg-[#252529]")">
                    @cat.Name
                </a>
            }
        </div>

        <!-- Products Grid Layout -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-4 pt-2">
            @foreach (var product in Model)
            {
                <button type="button"
                        onclick="openProductDetail('@product.ProductId')"
                        class="h-[130px] w-full bg-[#1c1c1e] hover:bg-[#242427] active:scale-[0.98] text-left rounded-2xl p-4 flex flex-col justify-between shadow-lg border border-neutral-800/80 hover:border-amber-500/40 cursor-pointer transition-all duration-150 group overflow-hidden focus:outline-none focus:border-amber-500/40">

                    <!-- Top Container -->
                    <div class="w-full flex items-start justify-between gap-2">
                        <span class="w-8 h-1 rounded-full bg-amber-500 group-hover:w-12 transition-all duration-300"></span>
                        <span class="text-[10px] font-mono tracking-wider text-neutral-500 uppercase group-hover:text-neutral-400">
                            @product.ProductCode
                        </span>
                    </div>

                    <!-- Middle Container -->
                    <div class="w-full flex-1 flex items-center pt-2 pb-1">
                        <h3 class="text-sm font-medium text-neutral-200 line-clamp-3 group-hover:text-white transition-colors duration-150 leading-snug">
                            @product.ProductName
                        </h3>
                    </div>
                </button>
            }
        </div>
    </div>

    <!-- PERSISTENT RIGHT SIDE BAR -->
    <aside class="hidden lg:flex w-96 bg-[#1c1c1e] border-l border-neutral-800/60 flex-col h-full overflow-hidden">
        <div class="p-4 border-b border-neutral-800 flex justify-between items-center">
            <span class="text-sm font-bold tracking-wider text-neutral-300 uppercase">Current Order</span>
            <span class="bg-neutral-800 text-amber-500 font-bold px-2.5 py-0.5 rounded text-xs">@cartCount Items</span>
        </div>
        <div class="flex-1 overflow-y-auto p-4 space-y-4">
            <vc:cart-items-list></vc:cart-items-list>
        </div>
        <div class="p-4 border-t border-neutral-800 bg-[#171719]">
            @await Html.PartialAsync("_CartFooterActions")
        </div>
    </aside>

</div>

<!-- PERSISTENT MOBILE BOTTOM BAR -->
<div class="fixed bottom-0 inset-x-0 bg-[#121212] border-t border-neutral-800/80 px-4 py-3 z-30 pb-5 lg:hidden">
    <div id="openCartBtn" class="bg-[#1c1c1e] p-2.5 rounded-full flex items-center justify-between cursor-pointer active:scale-95 transition-all duration-150">
        <span class="text-xs font-semibold text-neutral-300 pl-3">
            @cartCount Items | Total: <span class="text-amber-500 font-bold">$@cartTotal</span>
        </span>
        <button class="bg-[#664608] hover:bg-amber-700 text-amber-100 font-bold text-xs px-6 py-2.5 rounded-full uppercase tracking-wider transition-all duration-200">
            Pay
        </button>
    </div>
</div>

<!-- MOBILE DRAWER MODAL BOTTOM SHEET -->
<div id="cartSheetOverlay" class="fixed inset-0 bg-black/75 z-40 transition-opacity duration-300 opacity-0 pointer-events-none lg:hidden"></div>
<div id="cartSheet" class="fixed bottom-0 inset-x-0 bg-[#1c1c1e] rounded-t-3xl z-40 transform translate-y-full transition-transform duration-300 flex flex-col max-h-[85vh] lg:hidden">
    <div class="flex justify-center py-3.5 cursor-pointer" id="closeCartBtn">
        <div class="w-12 h-1.5 bg-neutral-700 rounded-full"></div>
    </div>
    <div class="overflow-y-auto px-5 py-2 space-y-4 flex-1">
        <vc:cart-items-list></vc:cart-items-list>
    </div>
    <div class="p-4 border-t border-neutral-800 bg-[#1c1c1e]">
        @await Html.PartialAsync("_CartFooterActions")
    </div>
</div>

<!-- MODIFIED PRODUCT DETAIL OVERLAY MODAL -->
<div id="productDetailModal" class="fixed inset-0 bg-black/80 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200">
    <div id="modalCard" class="bg-[#1c1c1e] border border-neutral-800 w-full max-w-xl rounded-2xl shadow-2xl flex flex-col overflow-hidden transform scale-95 transition-transform duration-200">

        <!-- Header -->
        <div class="p-4 border-b border-neutral-800 flex justify-between items-center bg-[#171719]">
            <div class="flex items-center space-x-3">
                <span class="text-sm font-bold tracking-wider text-neutral-300 uppercase">Product Detail</span>
                <span id="detailCode" class="text-[10px] font-mono tracking-wider text-amber-500 uppercase bg-amber-500/10 px-2 py-0.5 rounded-md border border-amber-600/20"></span>
            </div>
            <button onclick="closeProductDetailModal()" class="text-neutral-500 hover:text-white transition duration-150 flex items-center p-1 rounded-lg hover:bg-neutral-800">
                <span class="material-symbols-outlined text-xl">close</span>
            </button>
        </div>

        <div class="p-6 text-neutral-200 max-h-[70vh] overflow-y-auto">
            <!-- Loader State -->
            <div id="modalLoading" class="flex flex-col items-center justify-center py-12 space-y-3">
                <div class="w-9 h-9 border-2 border-amber-600 border-t-transparent rounded-full animate-spin"></div>
                <p class="text-xs text-neutral-500 font-medium tracking-wide">Fetching detail matrices...</p>
            </div>

            <div id="modalData" class="hidden space-y-5">
                <div>
                    <h2 id="detailName" class="text-2xl font-bold text-white leading-tight tracking-tight"></h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 border-t border-neutral-800/60 pt-4">
                    <!-- Left Side: Custom UI for Unit Selection Blocks -->
                    <div class="space-y-2.5">
                        <div id="unitOptionsContainer" class="space-y-2 max-h-[220px] overflow-y-auto pr-1 no-scrollbar">
                            <!-- Injected dynamically as selection nodes -->
                        </div>
                        <select id="detailUnitSelect" class="hidden"></select>
                    </div>

                    <!-- Right Side: Metrics, Editable Price, and Quantity Stepper -->
                    <div class="bg-[#171719] border border-neutral-800/80 rounded-xl p-4 flex flex-col justify-between space-y-4">
                        <div>
                            <p class="text-xs text-neutral-400 font-bold uppercase tracking-wider mb-1">Description</p>
                            <p id="detailDescription" class="text-xs text-neutral-400 leading-relaxed line-clamp-3"></p>
                        </div>

                        <!-- Editable Price Input Matrix -->
                        <div class="border-t border-neutral-800/80 pt-3">
                            <label class="text-[10px] font-bold uppercase tracking-wider text-neutral-500 block mb-1.5">Unit Price (MMK)</label>
                            <div class="relative">
                                <input type="number" id="detailPriceInput" step="0.01"
                                       class="w-full bg-[#1c1c1e] text-amber-500 text-xl font-black rounded-lg pl-3 pr-14 py-2 border border-neutral-700 focus:outline-none focus:border-amber-500 transition-colors" />
                                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-neutral-600 select-none">MMK</span>
                            </div>
                        </div>

                        <!-- Quantity Interface Stepper -->
                        <div class="border-t border-neutral-800/80 pt-3">
                            <label class="text-[10px] font-bold uppercase tracking-wider text-neutral-500 block mb-1.5">Quantity</label>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="updateModalQty(-1)" class="w-10 h-10 rounded-lg bg-neutral-800 text-neutral-300 flex items-center justify-center hover:bg-neutral-700 hover:text-white transition-colors active:scale-95">
                                    <span class="material-symbols-outlined text-sm">remove</span>
                                </button>
                                <input type="number" id="detailQtyInput" value="1" min="1"
                                       class="w-full bg-[#1c1c1e] text-center text-lg font-bold text-white rounded-lg py-1.5 border border-neutral-700 focus:outline-none focus:border-amber-500 transition-colors" />
                                <button type="button" onclick="updateModalQty(1)" class="w-10 h-10 rounded-lg bg-neutral-800 text-neutral-300 flex items-center justify-center hover:bg-neutral-700 hover:text-white transition-colors active:scale-95">
                                    <span class="material-symbols-outlined text-sm">add</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Footer -->
        <div class="p-4 border-t border-neutral-800 bg-[#171719] flex justify-end items-center gap-2">
            <button onclick="closeProductDetailModal()" class="px-5 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-[#252529] transition duration-150">
                Cancel
            </button>
            <button id="modalActionBtn" class="bg-amber-700/80 hover:bg-amber-600 active:bg-amber-800 text-amber-500 font-bold px-6 py-2.5 rounded-xl text-xs uppercase tracking-wider transition-all duration-150 shadow-md border border-amber-500/20 flex items-center space-x-2">
                <span class="material-symbols-outlined text-sm">shopping_cart</span>
                <span>Add to Order</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- MOBILE DRAWER EVENT PIPELINE ---
        const openCartBtn = document.getElementById('openCartBtn');
        const closeCartBtn = document.getElementById('closeCartBtn');
        const cartSheet = document.getElementById('cartSheet');
        const cartSheetOverlay = document.getElementById('cartSheetOverlay');

        function toggleCartSheet(isOpen) {
            if (!cartSheet) return;
            if (isOpen) {
                cartSheet.classList.remove('translate-y-full');
                cartSheetOverlay.classList.remove('opacity-0', 'pointer-events-none');
            } else {
                cartSheet.classList.add('translate-y-full');
                cartSheetOverlay.classList.add('opacity-0', 'pointer-events-none');
            }
        }

        openCartBtn?.addEventListener('click', () => toggleCartSheet(true));
        closeCartBtn?.addEventListener('click', () => toggleCartSheet(false));
        cartSheetOverlay?.addEventListener('click', () => toggleCartSheet(false));


        // --- DYNAMIC PRODUCT MODAL PIPELINE ---
        const modal = document.getElementById('productDetailModal');
        const modalCard = document.getElementById('modalCard');
        const modalLoading = document.getElementById('modalLoading');
        const modalData = document.getElementById('modalData');

        const detailCode = document.getElementById('detailCode');
        const detailName = document.getElementById('detailName');
        const detailDescription = document.getElementById('detailDescription');
        const unitOptionsContainer = document.getElementById('unitOptionsContainer');
        const detailPriceInput = document.getElementById('detailPriceInput');
        const detailQtyInput = document.getElementById('detailQtyInput');
        const modalActionBtn = document.getElementById('modalActionBtn');

        let currentProductUnits = [];
        let activeUnitIndex = 0;
        let selectedProductId = null;

        // Quantity helper modifier adjustment loops
        function updateModalQty(change) {
            let currentQty = parseInt(detailQtyInput.value) || 1;
            let newQty = currentQty + change;
            if (newQty >= 1) {
                detailQtyInput.value = newQty;
            }
        }

        async function openProductDetail(productId) {
            if (!modal) return;
            selectedProductId = productId;

            // Reset modal interaction properties to pure baseline defaults
            detailQtyInput.value = 1;
            detailPriceInput.value = "";

            modal.classList.remove('opacity-0', 'pointer-events-none');
            modalCard.classList.remove('scale-95');
            modalLoading.classList.remove('hidden');
            modalData.classList.add('hidden');
            unitOptionsContainer.innerHTML = '';

            try {
                const response = await fetch(`/Products/GetDetail/${productId}`);
                if (!response.ok) throw new Error('Data validation connection fault.');

                const product = await response.json();

                detailCode.textContent = product.ProductCode || product.productCode || 'GENERIC';
                detailName.textContent = product.ProductName || product.productName || 'Unknown Item';
                detailDescription.textContent = product.Description || product.description || 'No descriptive context provided for this product portfolio.';

                currentProductUnits = product.ProductUnits || product.productUnits || [];

                if (currentProductUnits.length > 0) {
                    activeUnitIndex = 0;

                    currentProductUnits.forEach((unit, index) => {
                        const uName = unit.UnitName || unit.unitName;
                        const uPrice = unit.UnitPrice || unit.unitPrice || 0;
                        const isReport = unit.IsReportUnit !== undefined ? unit.IsReportUnit : unit.isReportUnit;

                        const btn = document.createElement('button');
                        btn.type = "button";
                        btn.className = `w-full flex items-center justify-between p-3 rounded-xl border text-left transition-all duration-150 font-medium text-xs unit-select-node`;
                        btn.dataset.index = index;

                        btn.innerHTML = `
                            <span class="text-neutral-200 tracking-wide font-semibold text-[13px]">${uName}</span>
                            <span class="text-neutral-400 font-mono font-medium">${parseFloat(uPrice).toLocaleString()} MMK</span>
                        `;

                        if (isReport) {
                            activeUnitIndex = index;
                        }

                        btn.addEventListener('click', () => selectUnitOption(index));
                        unitOptionsContainer.appendChild(btn);
                    });

                    selectUnitOption(activeUnitIndex);
                } else {
                    detailPriceInput.value = 0;
                    unitOptionsContainer.innerHTML = `<div class="text-xs text-neutral-500 py-4 text-center">No retail options configured.</div>`;
                }

                modalLoading.classList.add('hidden');
                modalData.classList.remove('hidden');
            } catch (error) {
                console.error("API Fetch execution failure:", error);
                detailName.textContent = "Detail Error";
                detailDescription.textContent = "Unable to fetch exact detail metrics. Please check network connectivity parameters.";
                modalLoading.classList.add('hidden');
                modalData.classList.remove('hidden');
            }
        }

        function selectUnitOption(index) {
            activeUnitIndex = index;
            const targetUnit = currentProductUnits[index];
            if (!targetUnit) return;

            const uPrice = targetUnit.UnitPrice || targetUnit.unitPrice || 0;

            // Explicit mutable target population bound directly to input elements
            detailPriceInput.value = uPrice;

            const buttons = unitOptionsContainer.querySelectorAll('.unit-select-node');
            buttons.forEach((btn, idx) => {
                if (idx === parseInt(index)) {
                    btn.classList.remove('border-neutral-800/80', 'bg-[#171719]/40');
                    btn.classList.add('border-amber-600/60', 'bg-amber-900/10', 'ring-1', 'ring-amber-500/20');
                } else {
                    btn.classList.remove('border-amber-600/60', 'bg-amber-900/10', 'ring-1', 'ring-amber-500/20');
                    btn.classList.add('border-neutral-800/80', 'bg-[#171719]/40');
                }
            });
        }

        function updateCartUI(htmlResult) {
            const desktopCartContainer = document.querySelector('aside .flex-1.overflow-y-auto');
            if (desktopCartContainer) desktopCartContainer.innerHTML = htmlResult;

            const mobileCartContainer = document.querySelector('#cartSheet .overflow-y-auto');
            if (mobileCartContainer) mobileCartContainer.innerHTML = htmlResult;

            const parser = new DOMParser();
            const doc = parser.parseFromString(htmlResult, 'text/html');

            const itemsCount = doc.querySelectorAll('.dynamic-cart-row').length;

            const totalSpan = doc.querySelector('.text-xl.font-black.text-amber-500');
            const displayTotal = totalSpan ? totalSpan.textContent.trim() : "0 MMK";

            const desktopBadge = document.querySelector('aside span.bg-neutral-800');
            if (desktopBadge) desktopBadge.textContent = `${itemsCount} Items`;

            const mobileBarText = document.querySelector('#openCartBtn span.text-xs');
            if (mobileBarText) {
                mobileBarText.innerHTML = `${itemsCount} Items | Total: <span class="text-amber-500 font-bold">${displayTotal}</span>`;
            }
        }

        modalActionBtn?.addEventListener('click', async () => {
            const chosenUnit = currentProductUnits[activeUnitIndex];
            if (!chosenUnit) return;

            const finalPrice = parseFloat(detailPriceInput.value) || 0;
            const finalQuantity = parseInt(detailQtyInput.value) || 1;

            const payloadData = {
                productId: selectedProductId,
                unitId: chosenUnit.UnitId || chosenUnit.unitId,
                unitName: chosenUnit.UnitName || chosenUnit.unitName,
                unitPrice: finalPrice,
                quantity: finalQuantity
            };

            try {
                const response = await fetch('/Carts/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payloadData)
                });

                if (!response.ok) throw new Error('Network error processing cart.');

                const htmlResult = await response.text();
                updateCartUI(htmlResult);
                closeProductDetailModal();
            } catch (error) {
                console.error("Failed to update cart component layout matrices:", error);
            }
        });

        // 1. DYNAMIC MODIFIER: EDIT PRICE MODAL VIA GLOBAL CONTROLLER
        function promptEditPrice(productId, unitId, currentPrice) {
            if (!window.GlobalDialog) return;

            window.GlobalDialog.open({
                title: "Update Sale Price",
                message: "Enter a new sale price for this item. The updated price will apply to this order only.",
                showInput: true,
                defaultValue: currentPrice,
                onConfirm: async (inputValue) => {
                    const numericPrice = parseFloat(inputValue.replace(/,/g, ''));
                    if (isNaN(numericPrice) || numericPrice < 0) {
                        alert("Please enter a valid sale price.");
                        return;
                    }

                    try {
                        const response = await fetch('/Carts/UpdateCartItem', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ productId, unitId, unitPrice: numericPrice })
                        });
                        if (!response.ok) throw new Error('Faulty communication link loop.');

                        const html = await response.text();
                        updateCartUI(html);
                        window.GlobalDialog.close();
                    } catch (err) {
                        console.error("Failed custom pricing operation execution:", err);
                    }
                }
            });
        }

        // 2. DYNAMIC MODIFIER: DELETE ITEM MODAL VIA GLOBAL CONTROLLER
        function deleteCartItem(productId, unitId) {
            if (!window.GlobalDialog) return;

            window.GlobalDialog.open({
                title: "Remove Item",
                message: "Are you sure you want to remove this item from the current order?",
                showInput: false,
                onConfirm: async () => {
                    try {
                        const response = await fetch('/Carts/RemoveFromCart', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ productId, unitId })
                        });

                        if (!response.ok) {
                            throw new Error("Failed to remove the item.");
                        }

                        const html = await response.text();
                        updateCartUI(html);
                        window.GlobalDialog.close();
                    } catch (err) {
                        console.error("Error removing item:", err);
                        alert("Unable to remove the item. Please try again.");
                    }
                }
            });
        }

        async function adjustQty(productId, unitId, unitPrice, targetQty) {
            if (targetQty < 0) return;

            try {
                const response = await fetch('/Carts/UpdateCartItem', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        productId: productId,
                        unitId: unitId,
                        unitPrice: parseFloat(unitPrice),
                        quantity: parseInt(targetQty)
                    })
                });

                if (!response.ok) throw new Error('Faulty connection link while updating quantity.');

                const htmlResult = await response.text();
                updateCartUI(htmlResult);

            } catch (err) {
                console.error("Failed quantity adjustment operation execution:", err);
            }
        }

        window.adjustQty = adjustQty;

        function closeProductDetailModal() {
            modal.classList.add('opacity-0', 'pointer-events-none');
            const card = document.getElementById('modalCard');
            if (card) card.classList.add('scale-95');
        }

        modal?.addEventListener('click', (e) => {
            if (e.target === modal) closeProductDetailModal();
        });
    </script>
}