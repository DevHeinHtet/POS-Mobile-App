@model POSMobileApp.ViewModels.Carts.CartSummaryVM
@{
    var cart = Model ?? ViewData["CartDetails"] as POSMobileApp.ViewModels.Carts.CartSummaryVM ?? new POSMobileApp.ViewModels.Carts.CartSummaryVM();
}

@if (cart.Items.Count == 0)
{
    <div class="text-center py-8 text-neutral-500 text-xs">
        <span class="material-symbols-outlined text-3xl mb-2 block">shopping_basket</span>
        Your order tray is currently empty.
    </div>
}
else
{
    @foreach (var item in cart.Items)
    {
        <div class="flex items-center justify-between pb-3 border-b border-neutral-800/80">
            <div class="flex items-center gap-3">
                <span class="text-xs font-semibold text-amber-500 bg-[#322303] w-7 h-7 rounded-lg flex items-center justify-center">
                    @(item.Quantity)x
                </span>
                <div>
                    <h4 class="text-xs font-medium text-neutral-200">@item.ProductName</h4>
                    <span class="text-[11px] text-neutral-400">@item.UnitName</span>
                    <span class="text-[11px] text-amber-500 font-bold ml-1">
                        @String.Format("{0:N0}", item.UnitPrice) MMK
                    </span>
                </div>
            </div>
            <span class="text-xs font-mono font-bold text-neutral-300">
                @String.Format("{0:N0}", item.TotalPrice) MMK
            </span>
        </div>
    }

    <!-- Calculations Block -->
    <div class="pt-2 space-y-1.5 text-xs text-neutral-400">
        <div class="flex justify-between">
            <span>Subtotal:</span>
            <span class="text-neutral-200 font-medium">@String.Format("{0:N0}", cart.Subtotal) MMK</span>
        </div>
        <div class="flex justify-between">
            <span>Tax (8.5%):</span>
            <span class="text-neutral-200 font-medium">@String.Format("{0:N0}", cart.Tax) MMK</span>
        </div>
        <div class="flex justify-between text-base font-bold text-neutral-100 pt-1 border-t border-neutral-800">
            <span>Total:</span>
            <span class="text-amber-500">@String.Format("{0:N0}", cart.Total) MMK</span>
        </div>
    </div>
}