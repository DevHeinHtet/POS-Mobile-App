@{
    ViewData["Title"] = "Payment Management";
}

<div class="h-full flex flex-col bg-[#101820] p-4 sm:p-6 overflow-hidden">
    <!-- Top Bar -->
    <div class="flex items-center justify-between pb-5 border-b border-neutral-800/80 shrink-0">
        <div>
            <h1 class="text-lg font-bold text-neutral-100">Payment List</h1>
            <p class="text-xs text-neutral-400">View, create, and manage customer payment transactions</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" id="btnNewPayment" class="px-3.5 py-2 bg-[#FEE715] hover:bg-[#e6d113] text-[#101820] text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                New Payment
            </button>
            <button type="button" id="btnToggleFilters" class="md:hidden px-3 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-200 text-xs font-semibold rounded-xl border border-neutral-700/40 transition flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
                </svg>
                Filters
            </button>
        </div>
    </div>

    <!-- Filter Form -->
    <form id="filterForm" onsubmit="return false;" class="hidden md:flex mt-6 bg-[#171719] border border-neutral-800/80 rounded-2xl p-4 flex-wrap items-end gap-4 shadow-lg shrink-0">
        <input type="hidden" id="currentPage" name="page" value="1" />

        <div class="flex flex-col gap-1.5 flex-1 min-w-[240px] w-full">
            <label for="searchText" class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Search Payment</label>
            <input type="text" id="searchText" name="searchText" placeholder="Search remark or invoice..."
                   class="w-full bg-[#101820] border border-neutral-800 focus:border-[#FEE715]/50 text-neutral-200 placeholder-neutral-600 rounded-xl px-3 py-2 text-xs focus:outline-none transition" />
        </div>

        <div class="flex items-center gap-2 w-full md:w-auto justify-end">
            <button type="submit" class="flex-1 md:flex-none px-4 py-2 bg-[#FEE715] hover:bg-[#e6d113] text-[#101820] font-bold rounded-xl text-xs transition shadow-sm text-center">
                Filter
            </button>
            <button type="button" id="btnClear" class="flex-1 md:flex-none px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 font-medium rounded-xl text-xs transition border border-neutral-700/30 text-center">
                Clear
            </button>
        </div>
    </form>

    <!-- Table Container -->
    <div class="flex-1 min-h-0 mt-6 bg-[#171719] border border-neutral-800/80 rounded-2xl overflow-hidden flex flex-col shadow-xl">
        <div class="overflow-y-auto flex-1 p-0">

            <!-- DESKTOP TABLE VIEW -->
            <div class="hidden md:block">
                <table class="w-full text-left border-collapse min-w-[800px]">
                    <thead>
                        <tr class="bg-[#101820] border-b border-neutral-800 text-[11px] font-bold tracking-wider text-neutral-400 uppercase sticky top-0 z-10">
                            <th class="py-4 px-6">Payment ID</th>
                            <th class="py-4 px-6">Customer ID</th>
                            <th class="py-4 px-6 text-right">Amount</th>
                            <th class="py-4 px-6 text-center">Currency</th>
                            <th class="py-4 px-6">Date</th>
                            <th class="py-4 px-6">Remark</th>
                            <th class="py-4 px-6 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="paymentTableBody" class="divide-y divide-neutral-800/50 text-xs text-neutral-300">
                        <!-- Dynamic Rows -->
                    </tbody>
                </table>
            </div>

            <!-- MOBILE CARD VIEW -->
            <div id="paymentCardContainer" class="block md:hidden divide-y divide-neutral-800/60">
                <!-- Dynamic Cards -->
            </div>

        </div>

        <!-- Pagination Bar -->
        <div class="p-4 border-t border-neutral-800 bg-[#101820] flex flex-col sm:flex-row gap-3 items-center justify-between shrink-0 text-xs text-neutral-400">
            <div id="paginationInfo" class="text-center sm:text-left"></div>
            <div class="flex items-center gap-1.5" id="paginationControls"></div>
        </div>
    </div>
</div>

<!-- SAVE PAYMENT MODAL -->
<div id="paymentModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-[#171719] border border-neutral-800 w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden">
        <div class="p-5 border-b border-neutral-800 flex items-center justify-between">
            <h3 id="modalTitle" class="text-base font-bold text-neutral-100">Add Payment</h3>
            <button type="button" id="btnCloseModal" class="text-neutral-400 hover:text-neutral-200 transition">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form id="savePaymentForm" onsubmit="return false;" class="p-5 space-y-4">
            <input type="hidden" id="modalPaymentId" name="paymentId" />

            <div>
                <label for="modalInvoiceId" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-400 mb-1">Invoice ID <span class="text-rose-500">*</span></label>
                <input type="text" id="modalInvoiceId" name="invoiceId" required placeholder="Enter Invoice GUID"
                       class="w-full bg-[#101820] border border-neutral-800 focus:border-[#FEE715]/50 text-neutral-200 placeholder-neutral-600 rounded-xl px-3 py-2 text-xs focus:outline-none transition" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="modalAmount" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-400 mb-1">Amount <span class="text-rose-500">*</span></label>
                    <input type="number" step="any" id="modalAmount" name="amount" required placeholder="0.00"
                           class="w-full bg-[#101820] border border-neutral-800 focus:border-[#FEE715]/50 text-neutral-200 placeholder-neutral-600 rounded-xl px-3 py-2 text-xs focus:outline-none transition" />
                </div>
                <div>
                    <label for="modalCurrency" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-400 mb-1">Currency Exchange ID</label>
                    <input type="text" id="modalCurrency" name="currency" placeholder="Exchange GUID"
                           class="w-full bg-[#101820] border border-neutral-800 focus:border-[#FEE715]/50 text-neutral-200 placeholder-neutral-600 rounded-xl px-3 py-2 text-xs focus:outline-none transition" />
                </div>
            </div>

            <div>
                <label for="modalPaymentOn" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-400 mb-1">Payment Date & Time <span class="text-rose-500">*</span></label>
                <input type="datetime-local" id="modalPaymentOn" required
                       class="w-full bg-[#101820] border border-neutral-800 focus:border-[#FEE715]/50 text-neutral-200 placeholder-neutral-600 rounded-xl px-3 py-2 text-xs focus:outline-none transition" />
            </div>

            <div>
                <label for="modalRemark" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-400 mb-1">Remark</label>
                <textarea id="modalRemark" name="remark" rows="2" placeholder="Optional remark..."
                          class="w-full bg-[#101820] border border-neutral-800 focus:border-[#FEE715]/50 text-neutral-200 placeholder-neutral-600 rounded-xl px-3 py-2 text-xs focus:outline-none transition"></textarea>
            </div>

            <div id="modalAlert" class="hidden p-3 rounded-xl text-xs font-medium bg-rose-500/10 border border-rose-500/20 text-rose-400"></div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-neutral-800">
                <button type="button" id="btnCancelModal" class="px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 font-medium rounded-xl text-xs transition border border-neutral-700/30">
                    Cancel
                </button>
                <button type="submit" id="btnSavePayment" class="px-4 py-2 bg-[#FEE715] hover:bg-[#e6d113] text-[#101820] font-bold rounded-xl text-xs transition shadow-sm">
                    Save Payment
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const tableBody = document.getElementById("paymentTableBody");
        const cardContainer = document.getElementById("paymentCardContainer");
        const paginationInfo = document.getElementById("paginationInfo");
        const paginationControls = document.getElementById("paginationControls");
        const filterForm = document.getElementById("filterForm");
        const currentPageInput = document.getElementById("currentPage");
        const btnToggleFilters = document.getElementById("btnToggleFilters");
        const btnClear = document.getElementById("btnClear");

        // Modal Elements
        const paymentModal = document.getElementById("paymentModal");
        const btnNewPayment = document.getElementById("btnNewPayment");
        const btnCloseModal = document.getElementById("btnCloseModal");
        const btnCancelModal = document.getElementById("btnCancelModal");
        const savePaymentForm = document.getElementById("savePaymentForm");
        const modalAlert = document.getElementById("modalAlert");

        let paymentsDataCache = [];

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatDate(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            if (isNaN(date.getTime())) return '-';
            return date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        }

        function formatGuid(guidStr) {
            if (!guidStr) return '-';
            return guidStr.length > 8 ? `${guidStr.substring(0, 8)}...` : guidStr;
        }

        function formatToCustomDateString(dateObj) {
            const year = dateObj.getFullYear();
            const month = String(dateObj.getMonth() + 1).padStart(2, '0');
            const day = String(dateObj.getDate()).padStart(2, '0');
            let hours = dateObj.getHours();
            const minutes = String(dateObj.getMinutes()).padStart(2, '0');
            const seconds = String(dateObj.getSeconds()).padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            const strHours = String(hours).padStart(2, '0');
            return `${year}/${month}/${day} ${strHours}:${minutes}:${seconds} ${ampm}`;
        }

        // Modal Handler
        function openModal(isEdit = false, payment = null) {
            modalAlert.classList.add("hidden");
            modalAlert.innerText = "";
            savePaymentForm.reset();

            if (isEdit && payment) {
                document.getElementById("modalTitle").innerText = "Edit Payment";
                document.getElementById("modalPaymentId").value = payment.paymentId || "";
                document.getElementById("modalInvoiceId").value = payment.invoiceId || "";
                document.getElementById("modalAmount").value = payment.paymentAmount || "";
                document.getElementById("modalCurrency").value = payment.currencyExchangeId || "";
                document.getElementById("modalRemark").value = payment.remark || "";

                if (payment.paymentDate) {
                    const d = new Date(payment.paymentDate);
                    const localIso = new Date(d.getTime() - (d.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
                    document.getElementById("modalPaymentOn").value = localIso;
                }
            } else {
                document.getElementById("modalTitle").innerText = "Add Payment";
                document.getElementById("modalPaymentId").value = "";
                const nowLocal = new Date(new Date().getTime() - (new Date().getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
                document.getElementById("modalPaymentOn").value = nowLocal;
            }

            paymentModal.classList.remove("hidden");
        }

        function closeModal() {
            paymentModal.classList.add("hidden");
        }

        btnNewPayment.addEventListener("click", () => openModal(false));
        btnCloseModal.addEventListener("click", closeModal);
        btnCancelModal.addEventListener("click", closeModal);

        // Submit Logic (Posts JSON to SavePayment Endpoint)
        savePaymentForm.addEventListener("submit", function (e) {
            e.preventDefault();
            modalAlert.classList.add("hidden");

            const rawDate = document.getElementById("modalPaymentOn").value;
            if (!rawDate) {
                modalAlert.innerText = "Please select a valid payment date.";
                modalAlert.classList.remove("hidden");
                return;
            }

            const formattedPaymentOn = formatToCustomDateString(new Date(rawDate));

            const requestBody = {
                paymentId: document.getElementById("modalPaymentId").value || null,
                userId: "SYSTEM_USER", // Replace with session/user ID when available
                invoiceId: document.getElementById("modalInvoiceId").value,
                amount: document.getElementById("modalAmount").value,
                paymentOn: formattedPaymentOn,
                currency: document.getElementById("modalCurrency").value || null,
                remark: document.getElementById("modalRemark").value || ""
            };

            const btnSave = document.getElementById("btnSavePayment");
            btnSave.disabled = true;
            btnSave.innerText = "Saving...";

            fetch(`@Url.Action("SavePayment", "Payments")`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(requestBody)
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    modalAlert.innerText = data.message || "Failed to save payment.";
                    modalAlert.classList.remove("hidden");
                    return;
                }
                closeModal();
                fetchPayments();
            })
            .catch(err => {
                modalAlert.innerText = "System error occurred while saving.";
                modalAlert.classList.remove("hidden");
            })
            .finally(() => {
                btnSave.disabled = false;
                btnSave.innerText = "Save Payment";
            });
        });

        // Filter / Table Management
        btnToggleFilters.addEventListener("click", function() {
            filterForm.classList.toggle("hidden");
            filterForm.classList.toggle("flex");
        });

        filterForm.addEventListener("submit", function (e) {
            e.preventDefault();
            currentPageInput.value = 1;
            fetchPayments();
        });

        btnClear.addEventListener("click", function () {
            filterForm.reset();
            currentPageInput.value = 1;
            fetchPayments();
        });

        paginationControls.addEventListener("click", function (e) {
            const btn = e.target.closest(".btn-page");
            if (btn) {
                const targetPage = btn.getAttribute("data-page");
                if (targetPage) {
                    currentPageInput.value = targetPage;
                    fetchPayments();
                }
            }
        });

        function fetchPayments() {
            const formData = new FormData(filterForm);
            const params = new URLSearchParams(formData);

            tableBody.innerHTML = `<tr><td colspan="7" class="py-12 text-center text-neutral-500 font-medium text-xs">Loading payments...</td></tr>`;
            cardContainer.innerHTML = `<div class="py-12 text-center text-neutral-500 font-medium text-xs">Loading payments...</div>`;

            fetch(`@Url.Action("SearchAllPayment", "Payments")?${params.toString()}`)
                .then(res => res.json())
                .then(data => {
                    paymentsDataCache = data.items || [];
                    renderLayouts(paymentsDataCache);
                    renderPagination(data);
                })
                .catch(err => {
                    tableBody.innerHTML = `<tr><td colspan="7" class="py-12 text-center text-rose-500 font-medium text-xs">Failed to load payment data.</td></tr>`;
                    cardContainer.innerHTML = `<div class="py-12 text-center text-rose-500 font-medium text-xs">Failed to load payment data.</div>`;
                });
        }

        function renderLayouts(items) {
            if (!items || items.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="7" class="py-12 text-center text-neutral-500 font-medium text-xs">No payment records found.</td></tr>`;
                cardContainer.innerHTML = `<div class="py-12 text-center text-neutral-500 font-medium text-xs">No payment records found.</div>`;
                return;
            }

            let tableHtml = '';
            let cardHtml = '';

            items.forEach((payment, index) => {
                const fullPaymentId = escapeHtml(payment.paymentId);
                const displayPaymentId = formatGuid(fullPaymentId);
                const customerId = payment.customerId ? escapeHtml(payment.customerId) : 'N/A';
                const currencyCode = escapeHtml(payment.currencyExchangeCode || 'MMK');
                const remark = payment.remark && payment.remark.trim() !== '' ? escapeHtml(payment.remark) : '-';
                const formattedAmount = new Intl.NumberFormat().format(payment.paymentAmount || 0);
                const formattedDate = formatDate(payment.paymentDate);

                tableHtml += `
                    <tr class="hover:bg-neutral-800/30 transition-colors">
                        <td class="py-4 px-6 font-mono font-bold text-[#FEE715]" title="${fullPaymentId}">#${displayPaymentId}</td>
                        <td class="py-4 px-6 text-neutral-200 font-medium">${customerId}</td>
                        <td class="py-4 px-6 text-right font-bold text-neutral-100 font-mono">${formattedAmount}</td>
                        <td class="py-4 px-6 text-center">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[11px] font-semibold bg-neutral-800 text-[#FEE715] border border-neutral-700/60">
                                ${currencyCode}
                            </span>
                        </td>
                        <td class="py-4 px-6 text-neutral-400 font-mono text-[11px]">${formattedDate}</td>
                        <td class="py-4 px-6 text-neutral-400 max-w-[180px] truncate" title="${remark}">${remark}</td>
                        <td class="py-4 px-6 text-center">
                            <button type="button" onclick="editPaymentByIndex(${index})" class="px-2.5 py-1 bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-semibold rounded-lg text-[11px] border border-neutral-700/50 transition">
                                Edit
                            </button>
                        </td>
                    </tr>`;

                cardHtml += `
                    <div class="p-4 flex flex-col gap-3 hover:bg-neutral-800/20 transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="font-mono font-bold text-[#FEE715] text-sm" title="${fullPaymentId}">#${displayPaymentId}</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-neutral-800 text-[#FEE715] border border-neutral-700/60">
                                ${currencyCode}
                            </span>
                        </div>
                        <div>
                            <p class="text-neutral-200 font-semibold text-xs">Customer: ${customerId}</p>
                            <p class="text-neutral-500 text-[11px] mt-0.5">${remark}</p>
                        </div>
                        <div class="flex items-center justify-between pt-2 border-t border-neutral-800/40">
                            <div>
                                <span class="text-[10px] uppercase font-bold tracking-wider text-neutral-500 block">Date</span>
                                <span class="text-neutral-400 font-mono text-[11px]">${formattedDate}</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="text-right">
                                    <span class="text-[10px] uppercase font-bold tracking-wider text-neutral-500 block">Amount</span>
                                    <span class="text-neutral-100 font-mono font-bold text-sm">${formattedAmount}</span>
                                </div>
                                <button type="button" onclick="editPaymentByIndex(${index})" class="px-2.5 py-1 bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-semibold rounded-lg text-[11px] border border-neutral-700/50 transition">
                                    Edit
                                </button>
                            </div>
                        </div>
                    </div>`;
            });

            tableBody.innerHTML = tableHtml;
            cardContainer.innerHTML = cardHtml;
        }

        window.editPaymentByIndex = function(index) {
            const payment = paymentsDataCache[index];
            if (payment) {
                openModal(true, payment);
            }
        };

        function renderPagination(data) {
            const currentPage = data.currentPage || 1;
            const totalPages = data.totalPages || 1;
            const totalCount = data.totalCount || 0;

            paginationInfo.innerHTML = `Showing Page <span class="font-bold text-neutral-200">${currentPage}</span> of <span class="font-bold text-neutral-200">${totalPages}</span> <span class="text-neutral-500 sm:ml-1 block sm:inline">(${totalCount} total entries)</span>`;

            let controlsHtml = '';

            if (data.hasPreviousPage) {
                controlsHtml += `<button type="button" data-page="${currentPage - 1}" class="btn-page px-3 py-1.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-medium transition border border-neutral-700/30">Prev</button>`;
            } else {
                controlsHtml += `<span class="px-3 py-1.5 rounded-xl bg-neutral-900/60 text-neutral-600 border border-neutral-800/80 cursor-not-allowed select-none">Prev</span>`;
            }

            if (data.hasNextPage) {
                controlsHtml += `<button type="button" data-page="${currentPage + 1}" class="btn-page px-3 py-1.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-medium transition border border-neutral-700/30">Next</button>`;
            } else {
                controlsHtml += `<span class="px-3 py-1.5 rounded-xl bg-neutral-900/60 text-neutral-600 border border-neutral-800/80 cursor-not-allowed select-none">Next</span>`;
            }

            paginationControls.innerHTML = controlsHtml;
        }

        fetchPayments();
    });
</script>