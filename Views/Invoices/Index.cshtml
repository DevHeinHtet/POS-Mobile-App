@{
    ViewData["Title"] = "Invoices";
    var customers = ViewBag.Customers as List<POSMobileApp.ViewModels.DropdownViewModel> ?? new List<POSMobileApp.ViewModels.DropdownViewModel>();
    var staffs = ViewBag.Staffs as List<POSMobileApp.ViewModels.DropdownViewModel> ?? new List<POSMobileApp.ViewModels.DropdownViewModel>();
}

<div class="h-full flex flex-col bg-[#121212] p-4 sm:p-6 overflow-hidden">
    <!-- Header Area (Filters Toggle Only) -->
    <div class="flex items-center justify-end pb-5 border-b border-neutral-800/60 shrink-0">
        <!-- Mobile Toggle Button for Filters -->
        <button type="button" id="btnToggleFilters" class="md:hidden px-3 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-200 text-xs font-semibold rounded-xl border border-neutral-700/40 transition flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
            </svg>
            Filters
        </button>
    </div>

    <!-- Collapsible Filter Form -->
    <form id="filterForm" class="hidden md:flex mt-6 bg-[#1c1c1e] border border-neutral-800/80 rounded-2xl p-4 flex-wrap items-end gap-4 shadow-lg shrink-0">
        <input type="hidden" id="currentPage" name="page" value="1" />

        <div class="flex flex-col gap-1.5 flex-1 min-w-[180px] w-full">
            <label for="filterInvoiceNo" class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Invoice No</label>
            <input type="text" id="filterInvoiceNo" name="invoiceNo" placeholder="Search invoice no..."
                   class="w-full bg-[#121212] border border-neutral-800 focus:border-neutral-700 text-neutral-200 placeholder-neutral-600 rounded-xl px-3 py-2 text-xs focus:outline-none transition" />
        </div>

        <div class="flex flex-col gap-1.5 flex-1 min-w-[180px] w-full">
            <label for="filterCustomerId" class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Customer</label>
            <select id="filterCustomerId" name="customerId" class="w-full bg-[#121212] border border-neutral-800 focus:border-neutral-700 text-neutral-200 rounded-xl px-3 py-2 text-xs focus:outline-none transition">
                <option value="">All Customers</option>
                @foreach (var customer in customers)
                {
                    <option value="@customer.Key">@customer.Value</option>
                }
            </select>
        </div>

        <div class="flex flex-col gap-1.5 flex-1 min-w-[180px] w-full">
            <label for="filterStaffId" class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Staff / Operator</label>
            <select id="filterStaffId" name="staffId" class="w-full bg-[#121212] border border-neutral-800 focus:border-neutral-700 text-neutral-200 rounded-xl px-3 py-2 text-xs focus:outline-none transition">
                <option value="">All Staff</option>
                @foreach (var staff in staffs)
                {
                    <option value="@staff.Key">@staff.Value</option>
                }
            </select>
        </div>

        <div class="flex flex-col gap-1.5 w-full md:w-40">
            <label for="filterStatus" class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Status</label>
            <select id="filterStatus" name="status" class="w-full bg-[#121212] border border-neutral-800 focus:border-neutral-700 text-neutral-200 rounded-xl px-3 py-2 text-xs focus:outline-none transition">
                <option value="">All Statuses</option>
                <option value="New">New</option>
                <option value="Paid">Paid</option>
                <option value="Completed">Completed</option>
            </select>
        </div>

        <div class="flex items-center gap-2 w-full md:w-auto justify-end">
            <button type="submit" class="flex-1 md:flex-none px-4 py-2 bg-neutral-100 hover:bg-neutral-200 text-neutral-900 font-semibold rounded-xl text-xs transition shadow-sm text-center">
                Filter
            </button>
            <button type="button" id="btnClear" class="flex-1 md:flex-none px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 font-medium rounded-xl text-xs transition border border-neutral-700/30 text-center">
                Clear
            </button>
        </div>
    </form>

    <!-- Content Container -->
    <div class="flex-1 min-h-0 mt-6 bg-[#1c1c1e] border border-neutral-800/80 rounded-2xl overflow-hidden flex flex-col shadow-xl">
        <div class="overflow-y-auto flex-1 p-0">

            <!-- DESKTOP VIEW: HTML Table -->
            <div class="hidden md:block">
                <table class="w-full text-left border-collapse min-w-[900px]">
                    <thead>
                        <tr class="bg-[#171719] border-b border-neutral-800 text-[11px] font-bold tracking-wider text-neutral-400 uppercase sticky top-0 z-10">
                            <th class="py-4 px-6">Invoice No</th>
                            <th class="py-4 px-6">Customer</th>
                            <th class="py-4 px-6">Date</th>
                            <th class="py-4 px-6">Operator</th>
                            <th class="py-4 px-6">Status</th>
                            <th class="py-4 px-6 text-right">Total Cost</th>
                            <th class="py-4 px-6 text-right">Balance Due</th>
                            <th class="py-4 px-6 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="invoiceTableBody" class="divide-y divide-neutral-800/50 text-xs text-neutral-300">
                        <!-- Populated dynamically -->
                    </tbody>
                </table>
            </div>

            <!-- MOBILE VIEW: Card List layout -->
            <div id="invoiceCardContainer" class="block md:hidden divide-y divide-neutral-800/60">
                <!-- Populated dynamically -->
            </div>

        </div>

        <!-- Pagination Bar -->
        <div class="p-4 border-t border-neutral-800 bg-[#171719] flex flex-col sm:flex-row gap-3 items-center justify-between shrink-0 text-xs text-neutral-400">
            <div id="paginationInfo" class="text-center sm:text-left">
                <!-- Status text parsed dynamically -->
            </div>
            <div class="flex items-center gap-1" id="paginationControls">
                <!-- Control Buttons populated dynamically -->
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const tableBody = document.getElementById("invoiceTableBody");
        const cardContainer = document.getElementById("invoiceCardContainer");
        const paginationInfo = document.getElementById("paginationInfo");
        const paginationControls = document.getElementById("paginationControls");
        const filterForm = document.getElementById("filterForm");
        const currentPageInput = document.getElementById("currentPage");
        const btnToggleFilters = document.getElementById("btnToggleFilters");

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        btnToggleFilters.addEventListener("click", function() {
            const isHidden = filterForm.classList.contains("hidden");
            if (isHidden) {
                filterForm.classList.remove("hidden");
                filterForm.classList.add("flex");
            } else {
                filterForm.classList.remove("flex");
                filterForm.classList.add("hidden");
            }
        });

        function fetchInvoices() {
            const formData = new FormData(filterForm);
            const params = new URLSearchParams(formData);

            const loadingHtmlTable = `<tr><td colspan="8" class="py-12 text-center text-neutral-500 font-medium text-xs">Loading ledger records...</td></tr>`;
            const loadingHtmlCards = `<div class="py-12 text-center text-neutral-500 font-medium text-xs">Loading ledger records...</div>`;

            tableBody.innerHTML = loadingHtmlTable;
            cardContainer.innerHTML = loadingHtmlCards;

            fetch(`@Url.Action("GetInvoicesData", "Invoices")?${params.toString()}`)
                .then(res => {
                    if (!res.ok) throw new Error('Network payload failure');
                    return res.json();
                })
                .then(data => {
                    renderLayouts(data.items);
                    renderPagination(data);
                })
                .catch(err => {
                    console.error("Fetch Error:", err);
                    const errorTable = `<tr><td colspan="8" class="py-12 text-center text-rose-500 font-medium text-xs">Failed to retrieve backend payloads.</td></tr>`;
                    const errorCards = `<div class="py-12 text-center text-rose-500 font-medium text-xs">Failed to retrieve backend payloads.</div>`;
                    tableBody.innerHTML = errorTable;
                    cardContainer.innerHTML = errorCards;
                });
        }

        function renderLayouts(items) {
            if (!items || items.length === 0) {
                const emptyTable = `<tr><td colspan="8" class="py-12 text-center text-neutral-500 font-medium text-xs">No matching items detected.</td></tr>`;
                const emptyCard = `<div class="py-12 text-center text-neutral-500 font-medium text-xs">No matching items detected.</div>`;
                tableBody.innerHTML = emptyTable;
                cardContainer.innerHTML = emptyCard;
                return;
            }

            let tableHtml = '';
            let cardHtml = '';

            items.forEach(invoice => {
                const safeInvoiceNo = escapeHtml(invoice.invoiceNo);
                const safeCustomerName = escapeHtml(invoice.customerName || 'N/A');
                const safeOperatorName = escapeHtml(invoice.operatorName || 'N/A');
                const safeStatus = escapeHtml(invoice.status || 'New');

                const dateStr = invoice.invoiceDate ? new Date(invoice.invoiceDate).toISOString().replace('T', ' ').substring(0, 16) : '-';
                const totalCost = new Intl.NumberFormat().format(invoice.totalCost || 0);
                const balance = new Intl.NumberFormat().format(invoice.balance || 0);

                const balanceColor = (invoice.balance || 0) > 0 ? 'text-rose-400' : 'text-neutral-400';
                const detailsUrl = `@Url.Action("Details", "Invoices")/${invoice.invoiceId}`;

                let statusBadge = '';
                if (invoice.status === 'Paid') {
                    statusBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Paid</span>`;
                } else if (invoice.status === 'Completed') {
                    statusBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">Completed</span>`;
                } else {
                    statusBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">${safeStatus}</span>`;
                }

                tableHtml += `
                    <tr class="hover:bg-neutral-800/30 transition-colors">
                        <td class="py-4 px-6 font-mono font-semibold text-amber-500">${safeInvoiceNo}</td>
                        <td class="py-4 px-6 text-neutral-200">${safeCustomerName}</td>
                        <td class="py-4 px-6 text-neutral-400">${dateStr}</td>
                        <td class="py-4 px-6 text-neutral-400">${safeOperatorName}</td>
                        <td class="py-4 px-6">${statusBadge}</td>
                        <td class="py-4 px-6 text-right font-semibold text-neutral-200">${totalCost}</td>
                        <td class="py-4 px-6 text-right font-semibold ${balanceColor}">${balance}</td>
                        <td class="py-4 px-6 text-center">
                            <a href="${detailsUrl}" class="inline-flex items-center px-3 py-1 bg-neutral-800 hover:bg-neutral-700 hover:text-neutral-100 text-neutral-300 font-medium rounded-lg transition border border-neutral-700/40 text-[11px]">
                                View Details
                            </a>
                        </td>
                    </tr>`;

                cardHtml += `
                    <div class="p-4 flex flex-col gap-3 hover:bg-neutral-800/20 transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="font-mono font-bold text-amber-500 text-sm">${safeInvoiceNo}</span>
                            ${statusBadge}
                        </div>

                        <div class="grid grid-cols-2 gap-y-2 gap-x-4 text-xs">
                            <div>
                                <p class="text-[10px] uppercase font-bold tracking-wider text-neutral-500">Customer</p>
                                <p class="text-neutral-200 font-medium mt-0.5">${safeCustomerName}</p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase font-bold tracking-wider text-neutral-500">Operator</p>
                                <p class="text-neutral-400 mt-0.5">${safeOperatorName}</p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase font-bold tracking-wider text-neutral-500">Total Cost</p>
                                <p class="text-neutral-200 font-semibold mt-0.5">${totalCost}</p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase font-bold tracking-wider text-neutral-500">Balance Due</p>
                                <p class="${balanceColor} font-semibold mt-0.5">${balance}</p>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-1 mt-1 border-t border-neutral-800/40">
                            <span class="text-[11px] text-neutral-500">${dateStr}</span>
                            <a href="${detailsUrl}" class="px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-semibold rounded-lg transition border border-neutral-700/50 text-[11px] text-center shadow-sm">
                                View Details
                            </a>
                        </div>
                    </div>`;
            });

            tableBody.innerHTML = tableHtml;
            cardContainer.innerHTML = cardHtml;
        }

        function renderPagination(data) {
            paginationInfo.innerHTML = `Showing Page <span class="font-medium text-neutral-200">${data.currentPage}</span> of <span class="font-medium text-neutral-200">${data.totalPages}</span> <span class="text-neutral-500 sm:ml-1 block sm:inline">(${data.totalCount} entries total)</span>`;

            let controlsHtml = '';
            if (data.hasPreviousPage) {
                controlsHtml += `<button type="button" data-page="${data.currentPage - 1}" class="btn-page px-3 py-1.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-medium transition border border-neutral-700/30">Prev</button>`;
            } else {
                controlsHtml += `<span class="px-3 py-1.5 rounded-xl bg-neutral-800/40 text-neutral-600 border border-neutral-800/80 cursor-not-allowed select-none">Prev</span>`;
            }

            if (data.hasNextPage) {
                controlsHtml += `<button type="button" data-page="${data.currentPage + 1}" class="btn-page px-3 py-1.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-medium transition border border-neutral-700/30">Next</button>`;
            } else {
                controlsHtml += `<span class="px-3 py-1.5 rounded-xl bg-neutral-800/40 text-neutral-600 border border-neutral-800/80 cursor-not-allowed select-none">Next</span>`;
            }
            paginationControls.innerHTML = controlsHtml;
        }

        filterForm.addEventListener("submit", function (e) {
            e.preventDefault();
            currentPageInput.value = 1;

            if (window.innerWidth < 768) {
                filterForm.classList.add("hidden");
                filterForm.classList.remove("flex");
            }
            fetchInvoices();
        });

        paginationControls.addEventListener("click", function (e) {
            if (e.target.classList.contains("btn-page")) {
                currentPageInput.value = e.target.getAttribute("data-page");
                fetchInvoices();
            }
        });

        document.getElementById("btnClear").addEventListener("click", function () {
            filterForm.reset();
            currentPageInput.value = 1;
            fetchInvoices();
        });

        fetchInvoices();
    });
</script>