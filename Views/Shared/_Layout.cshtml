<!DOCTYPE html>
<html lang="en" class="h-full bg-[#121212]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Infinite Solution</title>
    <!-- Tailwind CSS (assumes your tailwind cli compiles to output.css) -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <!-- Google Material Symbols for Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
        /* Hide scrollbar for Chrome, Safari and Opera */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        /* Hide scrollbar for IE, Edge and Firefox */
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="h-full flex flex-col text-gray-200 antialiased overflow-hidden">

    <!-- GLOBAL TOAST NOTIFICATION CONTAINER (TOP-RIGHT CORNER) -->
    <div id="toastContainer" class="fixed top-5 right-5 z-[100] flex flex-col gap-3 max-w-sm w-full pointer-events-none"></div>

    <!-- Top Navigation Header -->
    <header class="h-16 bg-[#121212] border-b border-neutral-800/60 px-6 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-4">
            <button id="menuBtn" type="button" class="text-gray-300 hover:text-white focus:outline-none transition-colors">
                <span class="material-symbols-outlined text-2xl">menu</span>
            </button>
            <span class="text-base font-semibold tracking-wide text-neutral-100 hidden sm:inline-block">Infinite Solution Dashboard</span>
        </div>

        <span class="text-base font-semibold tracking-wide text-neutral-100 sm:hidden">Infinite Solution</span>

        <div class="flex items-center gap-4">
            <div class="hidden md:flex flex-col text-right text-xs text-neutral-400">
                <span class="font-medium text-neutral-200">Terminal #1</span>
                <span>Cashier Mode</span>
            </div>
            <button type="button" class="text-gray-300 hover:text-white focus:outline-none transition-colors">
                <span class="material-symbols-outlined text-2xl">person</span>
            </button>
        </div>
    </header>

    <!-- Drawer Overlay (Backdrop for Mobile Nav Only) -->
    <div id="drawerOverlay" class="fixed inset-0 bg-black/60 z-50 transition-opacity duration-300 opacity-0 pointer-events-none"></div>

    <!-- Sliding Sidebar Navigation Drawer -->
    <aside id="navDrawer" class="fixed inset-y-0 left-0 w-80 bg-[#1c1c1e] z-50 transform -translate-x-full transition-transform duration-300 shadow-2xl flex flex-col border-r border-neutral-800/80">
        
        <!-- ENHANCED DRAWER HEADER: Cashier Profile & Shift Status -->
        <div class="p-4 border-b border-neutral-800/80 bg-[#171719] flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-sm">
                        JS
                    </div>
                    <div>
                        <h4 class="text-xs font-bold text-neutral-200">POS Admin</h4>
                        <p class="text-[10px] text-emerald-400 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Shift Active (#1042)
                        </p>
                    </div>
                </div>
                <button id="closeDrawerBtn" class="text-neutral-400 hover:text-white p-1 rounded-lg hover:bg-neutral-800 transition">
                    <span class="material-symbols-outlined text-xl">close</span>
                </button>
            </div>

            <!-- Quick Shift Controls -->
            <div class="grid grid-cols-2 gap-2 pt-1">
                <button type="button" onclick="GlobalDialog.open({title: 'Lock Terminal', message: 'Are you sure you want to lock the screen for a break?', onConfirm: () => showMessage('Terminal Locked', 'info')})" class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg bg-neutral-800/80 hover:bg-neutral-800 text-[11px] font-medium text-neutral-300 transition border border-neutral-700/50">
                    <span class="material-symbols-outlined text-sm">lock</span> Lock
                </button>
                <button type="button" onclick="GlobalDialog.open({title: 'End Shift', message: 'Close current cashier shift and print summary report?', onConfirm: () => showMessage('Shift ended successfully', 'success')})" class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-[11px] font-medium text-rose-300 transition border border-rose-500/20">
                    <span class="material-symbols-outlined text-sm">logout</span> Close Shift
                </button>
            </div>
        </div>

        <!-- MAIN SCROLLABLE NAVIGATION CONTENT -->
        <div class="flex-1 overflow-y-auto no-scrollbar py-4 px-3 space-y-6">

            <!-- Touch-Optimized Quick Action Grid -->
            <div>
                <p class="px-2 text-[10px] font-bold uppercase tracking-wider text-neutral-500 mb-2">Shortcuts</p>
                <div class="grid grid-cols-2 gap-2">
                    <a href="@Url.Action("Index", "Home", new { category = "All" })" class="flex flex-col items-center justify-center p-3 rounded-xl bg-[#171719] border border-neutral-800 hover:border-amber-500/40 hover:bg-neutral-800/50 text-neutral-300 transition group">
                        <span class="material-symbols-outlined text-2xl text-amber-500 group-hover:scale-110 transition-transform">point_of_sale</span>
                        <span class="text-xs font-medium mt-1">Register</span>
                    </a>
                    <a href="@Url.Action("Index", "Invoices")" class="flex flex-col items-center justify-center p-3 rounded-xl bg-[#171719] border border-neutral-800 hover:border-amber-500/40 hover:bg-neutral-800/50 text-neutral-300 transition group">
                        <span class="material-symbols-outlined text-2xl text-sky-400 group-hover:scale-110 transition-transform">receipt_long</span>
                        <span class="text-xs font-medium mt-1">Invoices</span>
                    </a>
                </div>
            </div>

            <!-- Section 1: Operations -->
            <div>
                <p class="px-2 text-[10px] font-bold uppercase tracking-wider text-neutral-500 mb-2">Operations</p>
                <div class="space-y-1">
                    <a href="@Url.Action("Index", "Home", new { category = "All" })" class="flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20 transition">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-amber-400">grid_view</span>
                            <span>POS Terminal</span>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Invoices")" class="flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800/60 transition">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined">receipt_long</span>
                            <span>Invoices & History</span>
                        </div>
                    </a>
                </div>
            </div>

            <div>
                <p class="px-2 text-[10px] font-bold uppercase tracking-wider text-neutral-500 mb-2">Management</p>
                <div class="space-y-1">
                    <details class="group [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:bg-neutral-800/60 hover:text-white cursor-pointer transition">
                            <div class="flex items-center gap-3">
                                <span class="material-symbols-outlined">inventory_2</span>
                                <span>Inventory</span>
                            </div>
                            <span class="material-symbols-outlined text-lg text-neutral-500 group-open:-rotate-180 transition-transform duration-200">expand_more</span>
                        </summary>

                        <div class="mt-1 ml-4 pl-4 border-l border-neutral-800/80 space-y-1">
                            <a href="@Url.Action("Index", "Products")" class="block px-3 py-2 text-xs font-medium text-neutral-400 hover:text-amber-400 transition">Products</a>
                            <a href="#" class="block px-3 py-2 text-xs font-medium text-neutral-400 hover:text-amber-400 transition">Categories</a>
                        </div>
                    </details>

                    <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800/60 transition">
                        <span class="material-symbols-outlined">analytics</span> Reports & Sales
                    </a>
                    <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800/60 transition">
                        <span class="material-symbols-outlined">group</span> Staff & Shifts
                    </a>
                </div>
            </div>

            <div>
                <p class="px-2 text-[10px] font-bold uppercase tracking-wider text-neutral-500 mb-2">System</p>
                <div class="space-y-1">
                    <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-neutral-400 hover:text-white hover:bg-neutral-800/60 transition">
                        <span class="material-symbols-outlined">settings</span> System Settings
                    </a>
                </div>
            </div>

        </div>

        <div class="p-4 border-t border-neutral-800/80 bg-[#171719] flex items-center justify-between text-xs text-neutral-500 shrink-0">
            <span>Infinite Solution v1.0.0</span>
            <span class="flex items-center gap-1 text-[11px] text-emerald-400">
                <span class="material-symbols-outlined text-sm">print</span> Ready
            </span>
        </div>
    </aside>

    <main class="flex-1 overflow-hidden">
        @RenderBody()
    </main>

    <div id="posCustomDialog" class="fixed inset-0 bg-black/80 z-[60] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200">
        <div id="dialogCard" class="bg-[#1c1c1e] border border-neutral-800 w-full max-w-sm rounded-2xl shadow-2xl flex flex-col overflow-hidden transform scale-95 transition-transform duration-200">

            <div class="p-4 border-b border-neutral-800 flex items-center justify-between bg-[#171719]">
                <h3 id="dialogTitle" class="text-xs font-bold tracking-wider text-neutral-300 uppercase">Confirm Action</h3>
                <button type="button" id="dialogCloseBtn" class="text-neutral-500 hover:text-white transition p-1 rounded-lg hover:bg-neutral-800">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <p id="dialogMessage" class="text-xs text-neutral-400 leading-relaxed"></p>

                <div id="dialogInputWrapper" class="hidden relative">
                    <input type="text" id="dialogInputField"
                           class="w-full bg-[#121212] text-amber-500 font-mono font-bold text-lg rounded-xl px-4 py-3 focus:outline-none border border-neutral-800 focus:border-amber-600/50 transition duration-200" />
                </div>
            </div>

            <div class="p-4 border-t border-neutral-800 bg-[#171719] flex justify-end items-center gap-2">
                <button type="button" id="dialogCancelBtn" class="px-4 py-2 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 transition">
                    Cancel
                </button>
                <button type="button" id="dialogConfirmBtn" class="bg-amber-700/80 hover:bg-amber-600 text-amber-100 font-bold px-5 py-2 rounded-xl text-xs uppercase tracking-wider transition-all shadow-md border border-amber-500/20">
                    Confirm
                </button>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const menuBtn = document.getElementById('menuBtn');
        const closeDrawerBtn = document.getElementById('closeDrawerBtn');
        const navDrawer = document.getElementById('navDrawer');
        const drawerOverlay = document.getElementById('drawerOverlay');

        function toggleDrawer(isOpen) {
            if (isOpen) {
                navDrawer.classList.remove('-translate-x-full');
                drawerOverlay.classList.remove('opacity-0', 'pointer-events-none');
            } else {
                navDrawer.classList.add('-translate-x-full');
                drawerOverlay.classList.add('opacity-0', 'pointer-events-none');
            }
        }

        menuBtn?.addEventListener('click', () => toggleDrawer(true));
        closeDrawerBtn?.addEventListener('click', () => toggleDrawer(false));
        drawerOverlay?.addEventListener('click', () => toggleDrawer(false));

        class GlobalDialogController {
            constructor() {
                this.dialog = document.getElementById('posCustomDialog');
                this.card = document.getElementById('dialogCard');
                this.title = document.getElementById('dialogTitle');
                this.message = document.getElementById('dialogMessage');
                this.inputWrapper = document.getElementById('dialogInputWrapper');
                this.inputField = document.getElementById('dialogInputField');

                this.initEvents();
            }

            initEvents() {
                if (!this.dialog) return;

                document.getElementById('dialogCloseBtn')?.addEventListener('click', () => this.close());
                document.getElementById('dialogCancelBtn')?.addEventListener('click', () => this.close());
                this.dialog.addEventListener('click', (e) => {
                    if (e.target === this.dialog) this.close();
                });
            }

            open({ title, message, showInput = false, defaultValue = '', onConfirm }) {
                if (!this.dialog) return;

                this.title.textContent = title || 'Confirm Action';
                this.message.textContent = message || '';

                if (showInput) {
                    this.inputWrapper.classList.remove('hidden');
                    this.inputField.value = defaultValue;
                    setTimeout(() => this.inputField.focus(), 50);
                } else {
                    this.inputWrapper.classList.add('hidden');
                }

                const currentConfirmBtn = document.getElementById('dialogConfirmBtn');
                const newConfirmBtn = currentConfirmBtn.cloneNode(true);
                currentConfirmBtn.parentNode.replaceChild(newConfirmBtn, currentConfirmBtn);

                newConfirmBtn.addEventListener('click', () => {
                    if (showInput) {
                        onConfirm(this.inputField.value);
                    } else {
                        onConfirm();
                    }
                    this.close();
                });

                this.dialog.classList.remove('opacity-0', 'pointer-events-none');
                this.card.classList.remove('scale-95');
            }

            close() {
                if (!this.dialog) return;
                this.dialog.classList.add('opacity-0', 'pointer-events-none');
                this.card.classList.add('scale-95');
            }
        }

        window.GlobalDialog = new GlobalDialogController();

        function showMessage(message, type = 'success', duration = 3500) {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const isSuccess = type === 'success';
            const isError = type === 'error';

            const borderBgStyle = isSuccess
                ? 'bg-[#172517] border-emerald-500/30 text-emerald-300'
                : isError
                ? 'bg-[#291415] border-rose-500/30 text-rose-300'
                : 'bg-[#1a2332] border-sky-500/30 text-sky-300';

            const iconName = isSuccess ? 'check_circle' : isError ? 'error' : 'info';
            const iconColor = isSuccess ? 'text-emerald-400' : isError ? 'text-rose-400' : 'text-sky-400';

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center justify-between gap-3 px-4 py-3 rounded-xl border shadow-xl backdrop-blur-md transform transition-all duration-300 translate-y-[-10px] opacity-0 scale-95 ${borderBgStyle}`;

            toast.innerHTML = `
                <div class="flex items-center gap-3 overflow-hidden">
                    <span class="material-symbols-outlined text-xl ${iconColor} shrink-0">${iconName}</span>
                    <span class="text-xs font-medium tracking-wide truncate">${message}</span>
                </div>
                <button type="button" class="text-neutral-400 hover:text-white transition shrink-0 p-0.5 rounded-md hover:bg-white/10">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            `;

            const dismiss = () => {
                toast.classList.add('opacity-0', 'scale-95', 'translate-y-[-10px]');
                setTimeout(() => toast.remove(), 300);
            };

            toast.querySelector('button').addEventListener('click', dismiss);
            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('opacity-0', 'scale-95', 'translate-y-[-10px]');
            });

            if (duration > 0) {
                setTimeout(dismiss, duration);
            }
        }

        window.showMessage = showMessage;
    </script>
</body>
</html>