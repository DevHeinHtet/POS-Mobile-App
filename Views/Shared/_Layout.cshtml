<!DOCTYPE html>
<html lang="en" class="h-full bg-[#121212]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Infinite Solution</title>
    <!-- Tailwind CSS (assumes your tailwind cli compiles to site.css) -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <!-- Google Material Symbols for Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
            /* Hide scrollbar for Chrome, Safari and Opera */
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }
            /* Hide scrollbar for IE, Edge and Firefox */
            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
    </style>
</head>
<body class="h-full flex flex-col text-gray-200 antialiased overflow-hidden">

    <!-- Top Navigation Header -->
    <header class="h-16 bg-[#121212] border-b border-neutral-800/60 px-6 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-4">
            <button id="menuBtn" type="button" class="text-gray-300 hover:text-white focus:outline-none transition-colors">
                <span class="material-symbols-outlined text-2xl">menu</span>
            </button>
            <span class="text-base font-semibold tracking-wide text-neutral-100 hidden sm:inline-block">Infinite Solution Dashboard</span>
        </div>

        <span class="text-base font-semibold tracking-wide text-neutral-100 sm:hidden">Infinite Solution</span>

        <div class="flex items-center gap-4">
            <div class="hidden md:flex flex-col text-right text-xs text-neutral-400">
                <span class="font-medium text-neutral-200">Terminal #1</span>
                <span>Cashier Mode</span>
            </div>
            <button type="button" class="text-gray-300 hover:text-white focus:outline-none transition-colors">
                <span class="material-symbols-outlined text-2xl">person</span>
            </button>
        </div>
    </header>

    <!-- Drawer Overlay (Backdrop for Mobile Nav Only) -->
    <div id="drawerOverlay" class="fixed inset-0 bg-black/60 z-50 transition-opacity duration-300 opacity-0 pointer-events-none"></div>

    <!-- Sliding Sidebar Navigation Drawer -->
    <aside id="navDrawer" class="fixed inset-y-0 left-0 w-72 bg-[#1c1c1e] z-50 transform -translate-x-full transition-transform duration-300 shadow-2xl flex flex-col">
        <div class="p-4 border-b border-neutral-800 flex items-center justify-between">
            <span class="font-bold text-amber-500">Navigation</span>
            <button id="closeDrawerBtn" class="text-neutral-400 hover:text-white">
                <span class="material-symbols-outlined text-xl">close</span>
            </button>
        </div>
        <nav class="flex-1 px-3 py-4 space-y-1">
            <a href="@Url.Action("Index", "Products", new { category = "All" })" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-neutral-800 text-neutral-300 hover:text-white transition">
                <span class="material-symbols-outlined">grid_view</span> Home
            </a>
            <a href="@Url.Action("Index", "Invoices")" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-neutral-800 text-neutral-300 hover:text-white transition">
                <span class="material-symbols-outlined">receipt_long</span> Invoices
            </a>
            <a href="#" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-neutral-800 text-neutral-300 hover:text-white transition">
                <span class="material-symbols-outlined">settings</span> Settings
            </a>
        </nav>
        <div class="p-4 border-t border-neutral-800 text-xs text-neutral-500">
            Infinite Solution v1.0.0
        </div>
    </aside>

    <!-- Main Dynamic Content Region Wrapper -->
    <main class="flex-1 overflow-hidden">
        @RenderBody()
    </main>

    <!-- GLOBAL CUSTOM POS DIALOG BOX COMPONENT -->
    <div id="posCustomDialog" class="fixed inset-0 bg-black/80 z-[60] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200">
        <div id="dialogCard" class="bg-[#1c1c1e] border border-neutral-800 w-full max-w-sm rounded-2xl shadow-2xl flex flex-col overflow-hidden transform scale-95 transition-transform duration-200">

            <!-- Header Dynamic Info -->
            <div class="p-4 border-b border-neutral-800 flex items-center justify-between bg-[#171719]">
                <h3 id="dialogTitle" class="text-xs font-bold tracking-wider text-neutral-300 uppercase">Confirm Action</h3>
                <button type="button" id="dialogCloseBtn" class="text-neutral-500 hover:text-white transition p-1 rounded-lg hover:bg-neutral-800">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>

            <!-- Body Section Context -->
            <div class="p-6 space-y-4">
                <p id="dialogMessage" class="text-xs text-neutral-400 leading-relaxed"></p>

                <!-- Dynamic Input Container (Hidden by default, used for Edit Price) -->
                <div id="dialogInputWrapper" class="hidden relative">
                    <input type="text" id="dialogInputField"
                           class="w-full bg-[#121212] text-amber-500 font-mono font-bold text-lg rounded-xl px-4 py-3 focus:outline-none border border-neutral-800 focus:border-amber-600/50 transition duration-200" />
                </div>
            </div>

            <!-- Action Footer Controls -->
            <div class="p-4 border-t border-neutral-800 bg-[#171719] flex justify-end items-center gap-2">
                <button type="button" id="dialogCancelBtn" class="px-4 py-2 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 transition">
                    Cancel
                </button>
                <button type="button" id="dialogConfirmBtn" class="bg-amber-700/80 hover:bg-amber-600 text-amber-100 font-bold px-5 py-2 rounded-xl text-xs uppercase tracking-wider transition-all shadow-md border border-amber-500/20">
                    Confirm
                </button>
            </div>
        </div>
    </div>

    <!-- Render scripts from individual views -->
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Core Pipeline JavaScript Modules -->
    <script>
            // --- NAVIGATION SIDEBAR DRAWER LIFECYCLE CONTROLLER ---
            const menuBtn = document.getElementById('menuBtn');
            const closeDrawerBtn = document.getElementById('closeDrawerBtn');
            const navDrawer = document.getElementById('navDrawer');
            const drawerOverlay = document.getElementById('drawerOverlay');

            function toggleDrawer(isOpen) {
                if (isOpen) {
                    navDrawer.classList.remove('-translate-x-full');
                    drawerOverlay.classList.remove('opacity-0', 'pointer-events-none');
                } else {
                    navDrawer.classList.add('-translate-x-full');
                    drawerOverlay.classList.add('opacity-0', 'pointer-events-none');
                }
            }

            menuBtn.addEventListener('click', () => toggleDrawer(true));
            closeDrawerBtn.addEventListener('click', () => toggleDrawer(false));
            drawerOverlay.addEventListener('click', () => toggleDrawer(false));

            // --- ENCAPSULATED GLOBAL DIALOG STATE MATRIX CONTROLLER ---
            class GlobalDialogController {
                constructor() {
                    this.dialog = document.getElementById('posCustomDialog');
                    this.card = document.getElementById('dialogCard');
                    this.title = document.getElementById('dialogTitle');
                    this.message = document.getElementById('dialogMessage');
                    this.inputWrapper = document.getElementById('dialogInputWrapper');
                    this.inputField = document.getElementById('dialogInputField');

                    this.initEvents();
                }

                initEvents() {
                    if (!this.dialog) return;

                    document.getElementById('dialogCloseBtn')?.addEventListener('click', () => this.close());
                    document.getElementById('dialogCancelBtn')?.addEventListener('click', () => this.close());
                    this.dialog.addEventListener('click', (e) => {
                        if (e.target === this.dialog) this.close();
                    });
                }

                open({ title, message, showInput = false, defaultValue = '', onConfirm }) {
                    if (!this.dialog) return;

                    this.title.textContent = title || 'Confirm Action';
                    this.message.textContent = message || '';

                    if (showInput) {
                        this.inputWrapper.classList.remove('hidden');
                        this.inputField.value = defaultValue;
                        setTimeout(() => this.inputField.focus(), 50);
                    } else {
                        this.inputWrapper.classList.add('hidden');
                    }

                    // Dynamic live node isolation execution pattern to prevent overlapping listener bugs
                    const currentConfirmBtn = document.getElementById('dialogConfirmBtn');
                    const newConfirmBtn = currentConfirmBtn.cloneNode(true);
                    currentConfirmBtn.parentNode.replaceChild(newConfirmBtn, currentConfirmBtn);

                    newConfirmBtn.addEventListener('click', () => {
                        if (showInput) {
                            onConfirm(this.inputField.value);
                        } else {
                            onConfirm();
                        }
                    });

                    this.dialog.classList.remove('opacity-0', 'pointer-events-none');
                    this.card.classList.remove('scale-95');
                }

                close() {
                    if (!this.dialog) return;
                    this.dialog.classList.add('opacity-0', 'pointer-events-none');
                    this.card.classList.add('scale-95');
                }
            }

            // Expose globally to the global browser scope environment matrix
            window.GlobalDialog = new GlobalDialogController();
    </script>
</body>
</html>