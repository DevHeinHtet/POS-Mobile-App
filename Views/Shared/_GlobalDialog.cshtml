<div id="posCustomDialog" class="fixed inset-0 bg-black/80 z-[60] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200">
    <div id="dialogCard" class="bg-[#1c1c1e] border border-neutral-800 w-full max-w-sm rounded-2xl shadow-2xl flex flex-col overflow-hidden transform scale-95 transition-transform duration-200">

        <!-- Header -->
        <div class="p-4 border-b border-neutral-800 flex items-center justify-between bg-[#171719]">
            <h3 id="dialogTitle" class="text-xs font-bold tracking-wider text-neutral-300 uppercase">Confirm Action</h3>
            <button type="button" id="dialogCloseBtn" class="text-neutral-500 hover:text-white transition p-1 rounded-lg hover:bg-neutral-800">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>

        <!-- Body -->
        <div class="p-6 space-y-4">
            <p id="dialogMessage" class="text-xs text-neutral-400 leading-relaxed"></p>

            <!-- Dynamic Input Container -->
            <div id="dialogInputWrapper" class="hidden relative">
                <input type="text" id="dialogInputField"
                       class="w-full bg-[#121212] text-amber-500 font-mono font-bold text-lg rounded-xl px-4 py-3 focus:outline-none border border-neutral-800 focus:border-amber-600/50 transition duration-200" />
            </div>
        </div>

        <!-- Action Footer Controls -->
        <div class="p-4 border-t border-neutral-800 bg-[#171719] flex justify-end items-center gap-2">
            <button type="button" id="dialogCancelBtn" class="px-4 py-2 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 transition">
                Cancel
            </button>
            <button type="button" id="dialogConfirmBtn" class="bg-amber-700/80 hover:bg-amber-600 text-amber-100 font-bold px-5 py-2 rounded-xl text-xs uppercase tracking-wider transition-all shadow-md border border-amber-500/20">
                Confirm
            </button>
        </div>
    </div>
</div>